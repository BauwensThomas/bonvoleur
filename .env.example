# Copier en .env.local et adapter.
# En local : http://localhost:3000 | En production (Vercel) : https://bonvoleur.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Back-office admin (Phase 0, local). À remplacer par Supabase Auth en Phase 1.
ADMIN_PASSWORD=choisis-un-mot-de-passe-fort
ADMIN_TOKEN=un-jeton-aleatoire-long

# Verrou pré-lancement : si défini, TOUT le site exige ce mot de passe (page /acces).
# Pour ouvrir le site au public : supprimer cette variable (sur Vercel) et redéployer.
# SITE_GATE_PASSWORD=un-mot-de-passe-de-preview

# Agent content-publisher (génération d'article).
# Sans clé, l'agent produit un brouillon local de secours.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Protège l'endpoint cron /api/cron/content-publisher.
# Vercel Cron envoie automatiquement "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=

# Protège l'endpoint d'ingestion /api/ingest/deal (mode PUSH : le scanner atteint
# le site et y pousse les deals). Le script envoie "Authorization: Bearer <INGEST_SECRET>".
# INGEST_SECRET=

# Le scanner (scripts/scanner.py --supabase) écrit les deals DIRECTEMENT dans
# Supabase. Il a besoin de SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (voir plus bas),
# à mettre aussi en secrets GitHub Actions pour l'exécution planifiée.

# Script scanner (scripts/scanner.py) - variables côté script, pas côté site :
# TRAVELPAYOUTS_TOKEN=         # token gratuit https://www.travelpayouts.com
# TRAVELPAYOUTS_MARKER=        # ton id affilié (pour toucher des commissions)
# SCAN_TIMES=07:30,13:30,19:30 # heures de scan dans la journée (envoi juste après)
# WEEKLY_WEEKDAY=0             # jour du digest gratuit hebdo (0 = lundi)
# CRON_SECRET=                 # si défini côté site, le script l'envoie aux endpoints digest

# Email (couche agnostique lib/email.ts).
# Définis UNE des deux clés pour activer l'envoi réel. Sinon, log local.
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM="BonVoleur <contact@bonvoleur.com>"

# Phase 1 (à activer plus tard) :
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Variables locales (Phase 0). Ne pas committer (déjà ignoré par .gitignore).

# En local : http://localhost:3000 | En production (Vercel) : https://bonvoleur.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Accès au back-office admin (local). À changer.
ADMIN_PASSWORD=
ADMIN_TOKEN=

# Verrou pré-lancement : tant que cette variable est définie, tout le site exige
# ce mot de passe (page /acces). Pour ouvrir le site : supprimer cette ligne.
# SITE_GATE_PASSWORD=bTSpx6GCymW9btti

# Agent content-publisher (génération d'article).
# Sans clé, l'agent produit un brouillon local de secours.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Protège l'endpoint cron /api/cron/content-publisher.
# Vercel Cron envoie automatiquement "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Protège l'endpoint d'ingestion /api/ingest/deal (utilisé par le script Python
# qui scanne les offres 24/7). Le script envoie "Authorization: Bearer <INGEST_SECRET>".
INGEST_SECRET=

# Seed de deals de test pour l'espace membre : node scripts/seed-deals.mjs

# Email (couche agnostique lib/email.ts).
# Définis UNE des deux clés pour activer l'envoi réel. Sinon, log local.
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=

# Supabase (base de données et authentification).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_DB_URL=
SUPABASE_ACCESS_TOKEN=

# Script scanner (scripts/scanner.py) - variables côté script, pas côté site :
DEAL_SOURCE=
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
SCAN_TIMES= # heures de scan dans la journée (envoi juste après)
WEEKLY_WEEKDAY=            # jour du digest gratuit hebdo (0 = lundi)
# (CRON_SECRET déjà défini plus haut ligne 17 ; ne pas le redéfinir vide ici)


# Historique du scanner (GitHub Actions) dans l admin
GITHUB_REPO=
GITHUB_TOKEN=

# Unsplash API (pour les images d'illustration des articles)
UNSPLASH_ACCESS_KEY=

# Stripe LIVE (paiement et abonnements)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIG_ID=

# Make
MAKE_WEBHOOK_URL=

# Upstash (pour le backup de la base Supabase)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Glitchip
NEXT_PUBLIC_SENTRY_DSN=